# 仮身一覧の仮身操作と表示のメニュー (design 11.3), for tools/ui_run.py. Two copies of 画用紙
# holding four closed links (xmlbig), opened with 仮身一覧, one in the desktop's cabinet (open)
# and one in 仮身一覧 running as a process (pcab), are given the same. The second link taken,
# the menu opened at 600,400 (閉じる, the item chosen last, under the pointer; rows 20 apart)
# and 仮身操作 (its seventh row) opened beside it: what is grey in it -- 〈開く〉 not, as the
# object is not open in a window of the desktop's, 〈閉じる〉 so -- the process asks of the
# desktop (DT_RQ_LINK_STATE), and the shots of the opened menus (cabv_k_vobj, cabv_p_vobj)
# must be the same; so must those of 実身操作 (its eighth row, cabv_*_real) with 開くプログラム
# を固定. Esc puts each away. Then 隠蔽仮身を表示 (表示, its fourth row) is turned on and saved:
# record 0 of both must be the same (the link's view is not written; the page is unchanged).
cabproc kernel
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000001"
xml vobjleft="20" vobjtop="20" vobjright="180" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d2-7344-a6e2-6cede408d684_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000002"
