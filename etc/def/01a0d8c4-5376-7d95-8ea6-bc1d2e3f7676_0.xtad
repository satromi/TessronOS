<text num="4" x="24" y="108"> </text>
<text num="5" x="24" y="130"> </text>
<text num="6" x="24" y="152"> </text>
<text num="7" x="24" y="174"> </text>
<button num="101" rect="364,182,464,206" answer="ok" emph="true">確認</button>
</panel>
<panel num="4" rect="0,0,480,320" title="実身名一覧">
