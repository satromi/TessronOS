# 別に取得・生成するもの(ビルドの外に置く。配布するイメージはリリースで)
*.tpk
*.elf
*.map
*.lst
.VSCodeCounter/

# Python
__pycache__/
*.pyc

# エディタ・OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# 試験用に置く書体。再配布できるもの(Noto、SIL OFL 1.1)だけを追跡する。
# それ以外は資産なので置いても追跡しない(設計書 17.1)
etc/font/*
!etc/font/NotoSansJP-Regular.otf
!etc/font/OFL.txt

