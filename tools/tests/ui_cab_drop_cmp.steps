# 仮身一覧とほかのウインドウの間の仮身の受け渡し (design 11.3), for tools/ui_run.py. Two copies
# of 画用紙 holding four closed links (xmlbig), opened with 仮身一覧, one in the desktop's cabinet
# (open) and one in 仮身一覧 running as a process (pcab), are given the same: the second link
# carried out of the window into BTRON, the desktop's first window (let go at 50,190, where
# BTRON shows past the cabinet), where it is put and leaves the cabinet; then carried back
# from BTRON into the cabinet (let go at 600,500), where it is put and leaves BTRON, so that
# BTRON is as it was for the second half. Saved: record 0 of both must be the same, byte for
# byte but for the identity the link put back is given (sum anon); the shots (cabd_k_*,
# cabd_p_*) are compared afterwards: the cabinet's work area, and BTRON where it shows.
# Carried back, the link must have left BTRON: its ground shows again at 60,196.
cabproc kernel
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000001"
xml vobjleft="20" vobjtop="20" vobjright="180" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d2-7344-a6e2-6cede408d684_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000002"
xml vobjleft="20" vobjtop="60" vobjright="180" vobjbottom="79" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08cf-750a-8479-73bdcfc4823c_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000003"
xml vobjleft="20" vobjtop="100" vobjright="180" vobjbottom="119" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000004"
xml vobjleft="220" vobjtop="20" vobjright="380" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml </figure></tad>
xmlbig
apps big virtual-object-list
open big
waitwin 画用紙 600
sync 600
wait 800
click 167 193
sync 600
wait 600
move 167 193
down
move 140 193
wait 500
move 100 195
wait 500
move 70 192
wait 1000
move 50 190
wait 1000
up
sync 600
wait 800
move 890 690
wait 1500
shot cabd_k_out
move 60 196
down
move 90 220
wait 500
move 300 400
wait 500
move 600 500
wait 1000
up
sync 600
wait 800
move 890 690
wait 1500
shot cabd_k_back
pixel 60 196 F3FFFF
key 16 01
sync 600
sum show anon
keep kernel
key 08 01
sync 600
wait 500
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000001"
xml vobjleft="20" vobjtop="20" vobjright="180" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d2-7344-a6e2-6cede408d684_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000002"
xml vobjleft="20" vobjtop="60" vobjright="180" vobjbottom="79" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08cf-750a-8479-73bdcfc4823c_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000003"
xml vobjleft="20" vobjtop="100" vobjright="180" vobjbottom="119" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000004"
xml vobjleft="220" vobjtop="20" vobjright="380" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml </figure></tad>
xmlbig
apps big virtual-object-list
logmark
pcab big
expectsincein 60 cabinet: opened 画用紙 shapes 4 links 4
wait 800
click 167 193
wait 300
wait 600
logmark
move 167 193
down
move 140 193
wait 500
move 100 195
wait 500
move 70 192
wait 1000
move 50 190
wait 1000
up
expectsince cabinet: carried
expectsince cabinet: deleted, 3 shapes
wait 800
move 890 690
wait 1500
shot cabd_p_out
logmark
move 60 196
down
move 90 220
wait 500
move 300 400
wait 500
move 600 500
wait 1000
up
expectsince cabinet: dropped 1
wait 800
move 890 690
wait 1500
shot cabd_p_back
pixel 60 196 F3FFFF
logmark
key 16 01
expectsince cabinet: saved (0)
sum show anon
same kernel
key 08 01
expect cabinet: closed
wait 500
