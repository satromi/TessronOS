# The items done, in a new text of the same words, on the link picked: the menu is opened
# away from it, at 400,400 (閉じる there the first time, 仮身操作 200 below; then the item
# chosen last under the pointer, the rows of its menu from there down).
mkbig doc 1
xml <tad version="1.0" encoding="UTF-8"><document>
xml <p>仮身の前<link id="019a6c9b-e67e-7a35-a461-0d199550e4cf_0.xtad" vobjid="01a10000-0000-7000-8000-000000000001" width="160" heightpx="19" chsz="14"/>仮身の後</p>
xml <p>後の段落</p>
xml </document></tad>
xmlbig
logmark
pdoc big
expectsincein 60 document: opened 基本文章編集 paragraphs 2
wait 800
click 230 135
wait 600
