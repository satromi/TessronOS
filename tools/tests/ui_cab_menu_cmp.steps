xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000004"
xml vobjleft="220" vobjtop="20" vobjright="380" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml </figure></tad>
xmlbig
apps big virtual-object-list
open big
waitwin 画用紙 600
sync 600
wait 800
click 167 153
sync 600
wait 600
click 600 400 1
wait 600
wait 400
move 610 500
wait 300
move 720 500
wait 300
move 720 560
wait 300
click 720 560
sync 600
wait 600
move 890 690
wait 1500
shot cabm_k_bg
click 167 193
sync 600
wait 600
click 600 400 1
wait 600
wait 400
move 610 400
wait 300
move 720 400
wait 300
click 720 400
sync 600
wait 600
click 167 233
sync 600
wait 600
key 06 01
sync 600
key 19 01
sync 600
wait 600
move 890 690
wait 1500
shot cabm_k_paste
key 0F 01
sync 600
wait 1500
shot cabm_k_full
key 0F 01
sync 600
wait 1000
key 16 01
sync 600
sum show anon
keep kernel
click 600 400 1
wait 600
wait 400
move 610 300
wait 300
click 610 300
sync 600
sync 600
wait 500
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000001"
