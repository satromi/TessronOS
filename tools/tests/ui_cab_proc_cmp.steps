# 仮身一覧: the desktop's own and the process write the same record (design 11.3), for
# tools/ui_run.py. Two copies of 画用紙 holding four closed links (xmlbig), opened with
# 仮身一覧 (apps), are given the same changes, one in the desktop's cabinet (open) and one in
# 仮身一覧 running as a process (pcab): the first link carried 100 across and 200 down, the
# second sized by its handle, the third thrown away, the fourth put behind the others (Ctrl+R),
# then saved. Record 0 of both must be the same, byte for byte, and the window's work area
# the same, pixel for pixel (cab_k_* and cab_p_*). The fourth link stays taken after it is put
# behind, by its link, and its orange frame stays on the screen: a cabinet's frames do not
# blink, as the figure editor's do.
cabproc kernel
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000001"
xml vobjleft="20" vobjtop="20" vobjright="180" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d2-7344-a6e2-6cede408d684_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000002"
xml vobjleft="20" vobjtop="60" vobjright="180" vobjbottom="79" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08cf-750a-8479-73bdcfc4823c_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000003"
xml vobjleft="20" vobjtop="100" vobjright="180" vobjbottom="119" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000004"
xml vobjleft="220" vobjtop="20" vobjright="380" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml </figure></tad>
xmlbig
apps big virtual-object-list
open big
waitwin 画用紙 600
sync 600
wait 800
move 890 690
sync 600
wait 600
shot cab_k_open
click 167 153
sync 600
wait 600
drag 167 153 267 353
sync 600
click 167 193
sync 600
shot cab_k_pick2
wait 600
drag 288 205 328 225
sync 600
click 167 233
key 4C
sync 600
click 357 153
sync 600
key 15 01
sync 600
move 890 690
sync 600
wait 1500
shot cab_k_done
pixel 400 146 FF8F00
redraw
sync 600
shot cab_k_redrawn
key 16 01
sync 600
sum show
keep kernel
key 08 01
sync 600
wait 500
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000001"
xml vobjleft="20" vobjtop="20" vobjright="180" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d2-7344-a6e2-6cede408d684_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000002"
xml vobjleft="20" vobjtop="60" vobjright="180" vobjbottom="79" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08cf-750a-8479-73bdcfc4823c_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000003"
xml vobjleft="20" vobjtop="100" vobjright="180" vobjbottom="119" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000004"
xml vobjleft="220" vobjtop="20" vobjright="380" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml </figure></tad>
xmlbig
apps big virtual-object-list
logmark
pcab big
expectsincein 60 cabinet: opened 画用紙 shapes 4 links 4
wait 800
move 890 690
wait 500
shot cab_p_open
logmark
click 167 153
wait 600
drag 167 153 267 353
expectsince cabinet: moved 1 by 100,200
logmark
click 167 193
wait 600
drag 288 205 328 225
expectsince cabinet: sized
logmark
click 167 233
key 4C
expectsince cabinet: deleted, 3 shapes
logmark
click 357 153
wait 600
key 15 01
expectsince cabinet: links to the back
move 890 690
wait 1500
shot cab_p_done
pixel 400 146 FF8F00
logmark
key 16 01
expectsince cabinet: saved (0)
sum show
same kernel
key 08 01
expect cabinet: closed
