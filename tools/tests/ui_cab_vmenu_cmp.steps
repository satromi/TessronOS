xml vobjleft="20" vobjtop="100" vobjright="180" vobjbottom="119" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml <link id="01a0d6d1-08d1-781f-8f58-35c45aeacef9_0.xtad" vobjid="01a0d8c4-ca00-7000-8000-000000000004"
xml vobjleft="220" vobjtop="20" vobjright="380" vobjbottom="39" height="19" chsz="14" frcol="#000000"
xml chcol="#000000" tbcol="#ffffff" bgcol="#ffffff" pictdisp="true" namedisp="true" framedisp="true"/>
xml </figure></tad>
xmlbig
apps big virtual-object-list
open big
waitwin 画用紙 600
sync 600
wait 800
click 167 193
sync 600
wait 600
click 600 400 1
wait 600
wait 400
move 610 520
wait 300
move 720 520
wait 1200
shot cabv_k_vobj
key 29
wait 600
key 29
sync 600
click 600 400 1
wait 600
wait 400
move 610 540
wait 300
move 720 540
wait 1200
shot cabv_k_real
key 29
wait 600
key 29
sync 600
click 600 400 1
wait 600
wait 400
move 610 460
wait 300
move 720 460
wait 300
move 720 520
wait 300
click 720 520
sync 600
wait 800
move 890 690
wait 1500
shot cabv_k_hidden
key 16 01
sync 600
sum show
keep kernel
click 600 400 1
wait 600
wait 400
move 610 340
wait 300
click 610 340
sync 600
wait 500
mkbig fig 1 0
xml <tad version="1.0" encoding="UTF-8"><figure>
